#!/usr/bin/env bash
set -euo pipefail

AGENTVILLE_PORT="${AGENTVILLE_PORT:-4200}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ ! -d "$APP_DIR/.next" ]; then
  echo "Building AgentVille..."
  cd "$APP_DIR"
  npm run build
fi

STANDALONE_DIR="$APP_DIR/.next/standalone"

# Next.js standalone requires static assets and public dir to be copied in
if [ -d "$APP_DIR/.next/static" ] && [ ! -d "$STANDALONE_DIR/.next/static" ]; then
  cp -R "$APP_DIR/.next/static" "$STANDALONE_DIR/.next/static"
fi
if [ -d "$APP_DIR/public" ] && [ ! -d "$STANDALONE_DIR/public" ]; then
  cp -R "$APP_DIR/public" "$STANDALONE_DIR/public"
fi

echo "Starting AgentVille on http://localhost:${AGENTVILLE_PORT}"
PORT="$AGENTVILLE_PORT" node "$STANDALONE_DIR/server.js"
